# Test evidence: screenshots, videos, traces and dumps stay local.
# Only the written reports (*.md) are versioned.
tasks/evidence/**
!tasks/evidence/**/
!tasks/evidence/**/*.md
tasks/review/sdk58-logs/

# Release keystore: generated locally, never committed (this repository is public).
keystore/*
!keystore/README.md
!keystore/create-keystore.sh
!keystore/signing.properties.example
